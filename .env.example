# ===========================================
# Application
# ===========================================
CAMERA_HOST=0.0.0.0
CAMERA_PORT=8579
# Host port for the API in docker-compose.prod.yml (container side is fixed at 8579)
APP_PORT=8579
MCP_PORT=8580

# ===========================================
# Camera
# ===========================================
CAMERA_MAX_WIDTH=1280
CAMERA_JPEG_QUALITY=85

# Location name(s) for this deployment (comma-separated).
# 'default' marks the place used when a location is not specified.
# Examples:
#   CAMERA_PLACES=default,home   (home instance, also the default)
#   CAMERA_PLACES=office         (office instance)
CAMERA_PLACES=default

# ===========================================
# Logging
# ===========================================
CAMERA_LOG_LEVEL=INFO

# ===========================================
# MCP Server
# ===========================================
# URL of the running camera API (for MCP server)
CAMERA_API_URL=http://localhost:8579

# ===========================================
# Security
# ===========================================
# Required bearer token for the camera API. The MCP server uses it to call the API.
# Generate one with: openssl rand -hex 32
CAMERA_AUTH_TOKEN=
# Required bearer token for the MCP server (network transports).
# MCP clients must send it as `Authorization: Bearer <MCP_AUTH_TOKEN>`.
MCP_AUTH_TOKEN=
